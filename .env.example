ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_PAPER=true

# --- Módulo cripto (solo si usas --broker binance o --broker bitso en
# scripts/run_crypto_live_once.py; el broker virtual --broker virtual, el
# default, NO necesita nada de esto) ---

# Genera claves de TESTNET en https://testnet.binance.vision (NO las de tu cuenta real)
BINANCE_API_KEY=your_binance_testnet_key_here
BINANCE_SECRET_KEY=your_binance_testnet_secret_here
BINANCE_TESTNET=true

# Bitso NO TIENE TESTNET -- estas claves y BITSO_CONFIRM_REAL_MONEY=true mueven MXN
# real. Déjalo como está (false/vacío) hasta que hayas validado la estrategia con
# --broker virtual durante varias semanas. Genera las claves en bitso.com -> API.
BITSO_API_KEY=
BITSO_SECRET_KEY=
BITSO_CONFIRM_REAL_MONEY=false

# --- Alertas (opcional, cualquiera de las dos secciones, o ambas, o ninguna) ---

# Email vía SMTP (ej. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=tu@gmail.com, SMTP_PASSWORD=una "app password", no tu contraseña normal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Telegram: crea un bot con @BotFather, y consigue tu chat_id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
